# Telegram Bot Tokens
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN_INTEL=9876543210:ZYXwvuTSRqpONMlkJIHgfEDCba
# Referenced by the "agent-bot" entry in config/bots.example.json
TELEGRAM_BOT_TOKEN_AGENT=1122334455:AbCdEfGhIjKlMnOpQrStUvWxYz

# Ollama Configuration
# config.example.json ships "baseUrl": "${OLLAMA_BASE_URL}", so this value is
# what the app actually connects to. It is REQUIRED: an unset variable
# interpolates to an empty string and config validation then fails with
# "ollama.baseUrl: Invalid url" at startup.
#
# Two supported topologies:
#   1. Direct to Ollama Cloud (no sidecar container, smaller host):
#        OLLAMA_BASE_URL=https://ollama.com
#        OLLAMA_API_KEY=<key from https://ollama.com/settings/keys>
#      Ollama Cloud serves NO embedding models, so soul.search must be off.
#   2. Local daemon / Compose sidecar (needed for soul.search or local models):
#        OLLAMA_BASE_URL=http://ollama:11434   (or http://127.0.0.1:11434 bare metal)
#        OLLAMA_API_KEY=                       (leave blank — no auth header is sent)
#
# The default below is the COMPOSE service name, not loopback. Inside a
# container 127.0.0.1 is the container itself, so a loopback value silently
# fails every LLM call even with the sidecar running — and the compose default
# (`${OLLAMA_BASE_URL:-http://ollama:11434}`) cannot save you, because a value
# present in .env is never absent. Change this to http://127.0.0.1:11434 only
# when running the framework directly on the host with `bun run src/index.ts`.
OLLAMA_BASE_URL=http://ollama:11434

# Bearer token for Ollama Cloud. Leave BLANK for a local daemon: when blank,
# no Authorization header is sent at all. See docs/deployment-cloud.md §5.
OLLAMA_API_KEY=

# Admin / Operator API auth
# Required by the admin auth middleware, which is fail-closed: if this is unset
# every /api/admin/* request is rejected with 503. It also acts as a super-tenant
# bearer token in multi-tenant mode. Generate with: openssl rand -hex 32
# WARNING: this does NOT protect the dashboard or /api/* in single-tenant mode —
# those routes have no auth at all. See docs/deployment-cloud.md.
ADMIN_API_KEY=

# Brave Search API (for web tools)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here

# Boot-time bot start (escape hatch)
# Every bot with "enabled": true in config/bots.json is started automatically on
# each process start, so a reboot or redeploy brings it back without a human.
# Set this to false to bring the container up with NOTHING polling Telegram —
# the cutover case, where the previous instance still owns the tokens. It
# overrides startup.autoStartBots in config/config.json, because during a
# cutover .env is reachable and the config file is inside a Docker volume.
# Deliberately shipped COMMENTED OUT: while it is set it wins over the config
# file, so leaving "=true" in .env would silently override an operator who later
# turns startup.autoStartBots off. Uncomment only while you need it.
#AIBOT_AUTOSTART_BOTS=false

# Logging
LOG_LEVEL=info

# Twilio (Phone Call skill)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+0987654321

# OpenAI (Whisper voice transcription)
OPENAI_API_KEY=your-openai-api-key-here

# ElevenLabs (TTS voice output)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Reddit API (OAuth2 script app — reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password

# Twitter/X API v2 (developer.twitter.com)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# Calendar (Calendly or Google Calendar)
CALENDAR_API_KEY=your-calendar-api-key
CALENDAR_ID=primary

# GitHub (intel-gatherer skill — raises the anonymous API rate limit)
GITHUB_TOKEN=your-github-personal-access-token

# Stripe billing (only used when multiTenant.enabled and a Stripe billing
# provider is configured — leave blank otherwise)
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
